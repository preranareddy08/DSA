#include<bits/stdc++.h>
using namespace std;

int SecondLargest(vector<int>&arr){
	int slargest = -1;
	int largest = arr[0];
	for(int i=1;i<arr.size();i++){
		if(arr[i]>largest){
			slargest = largest;
			largest = arr[i];
		}
		else if(arr[i]<largest && arr[i]<slargest){
			slargest = largest;
		}
	}
	return slargest;

}
int main(){
	int n;
	cin>>n;
	vector<int>arr(n);
	for(int i=0;i<n;i++){
		cin>>arr[i];
	}
	cout<<SecondLargest(arr);
}
