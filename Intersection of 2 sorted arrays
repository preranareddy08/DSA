#include<bits/stdc++.h>
using namespace std;

vector<int> IntersectionArray(vector<int>& arr1, vector<int>& arr2, int m, int n){
    vector<int> interarr;
    int i = 0, j = 0;
    while(i<m && j<n){
    	if(arr1[i]<arr2[j]) i++;
    	else if(arr2[j]<arr1[i]) j++;
    	else{
    		interarr.push_back(arr1[i]);
    		i++;
    		j++;
    	}
    }
 return interarr;
}

int main(){
    int m, n;
    cin >> m >> n;

    vector<int> arr1(m), arr2(n);

    for(int i = 0; i < m; i++) cin >> arr1[i];
    for(int i = 0; i < n; i++) cin >> arr2[i];

    vector<int> res = IntersectionArray(arr1, arr2, m, n);

    for(int x : res) cout << x << " ";
}

T.C : O(m+n)
S.C : O(1)
