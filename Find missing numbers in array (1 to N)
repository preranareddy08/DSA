#BRUTEFORCE

#include<bits/stdc++.h>
using namespace std;

vector<int>MissingNum(vector<int>&arr, int m, int n){
	 vector<int>ans;
    for(int i=1;i<=m;i++){
    	int flag = 0;
    	for(int j=0;j<n;j++){
    		if(arr[j]==i){
    			flag = 1;
    			break;
    		}
    	}
    	if(flag==0) ans.push_back(i);

    }
  return ans;
   
}

int main(){
    int m,n;
    cin >> m >>n;

    vector<int>arr(n);

    for(int i = 0; i < n; i++) cin >> arr[i];

    vector<int>res = MissingNum(arr, m, n);
   for(auto it:res){
   	cout<<it<<" ";
   }
}

T.C : O(N^2)
S.C : O(1)


#OPTIMAL

🔹 Cyclic Sort 

-Numbers are in range 1 to m.
-Each number should be at index value − 1.
-Place every element at its correct index using swapping.
-After placement, check the array:
-If arr[i] ≠ i + 1 → number i + 1 is missing.


#include<bits/stdc++.h>
using namespace std;

vector<int> findMissing(vector<int>& arr, int m) {
    int n = arr.size();

    // place elements at correct positions
    for(int i = 0; i < n; i++) {
        while(arr[i] >= 1 && arr[i] <= m &&
              arr[i] <= n &&
              arr[i] != arr[arr[i] - 1]) {
            swap(arr[i], arr[arr[i] - 1]);
        }
    }

    vector<int> ans;

    // numbers missing within array size
    for(int i = 0; i < n; i++) {
        if(arr[i] != i + 1)
            ans.push_back(i + 1);
    }

    // numbers beyond array size
    for(int i = n + 1; i <= m; i++) {
        ans.push_back(i);
    }

    return ans;
}

int main() {
    int m = 8;
    vector<int> arr = {1, 3, 5};

    vector<int> res = findMissing(arr, m);

    for(int x : res)
        cout << x << " ";
}

T.C : O(N)
S.C : O(1)
  
